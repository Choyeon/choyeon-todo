{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Choyeon To Do",
  "version": "2.0.4",
  "identifier": "com.choyeon.todo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Choyeon To Do - 任务管理",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "dragDropEnabled": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "appimage"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon-16x16.png",
      "icons/icon-32x32.png",
      "icons/icon-48x48.png",
      "icons/icon-64x64.png",
      "icons/icon-128x128.png",
      "icons/icon-256x256.png",
      "icons/icon-512x512.png"
    ],
    "copyright": "Copyright © 2026 Choyeon",
    "createUpdaterArtifacts": true,
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Choyeon/choyeon-todo/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwRDhDMjY0RDVFRDZFNkUKUldSdWJ1M1ZaTUxZb0I5SWpWamFpdVUxWXhHOW4zNXRaYXhCNHRTSUJxY3JLL3ZVdEE4Q1UxUnkK"
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "choyeon-todo"
        ]
      }
    }
  }
}
