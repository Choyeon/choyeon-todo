{
  "name": "todolist-app",
  "private": true,
  "version": "2.0.5",
  "type": "module",
  "description": "Choyeon To Do - A task management application",
  "author": "Choyeon <c******@***********>",
  "homepage": "https://github.com/choyeon/todolist-app",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:win": "tauri build --target x86_64-pc-windows-msvc",
    "tauri:build:mac": "tauri build --target universal-apple-darwin",
    "tauri:build:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "tauri:check": "tauri info",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .vue,.js,.cjs",
    "lint:fix": "eslint . --ext .vue,.js,.cjs --fix",
    "format": "prettier --write \"src/**/*.{vue,js,css}\" \"src-tauri/src/**/*.rs\" \"tests/**/*.{js,vue}\"",
    "build:pages": "cross-env GITHUB_PAGES=true vite build",
    "deploy:pages": "cross-env GITHUB_PAGES=true vite build && gh-pages -d dist-web -b gh-pages"
  },
  "overrides": {
    "workbox-build>glob": "^11.1.0",
    "ajv>fast-uri": "^3.1.8"
  },
  "dependencies": {
    "@lucide/vue": "^1.23.0",
    "@tauri-apps/api": "^2.12.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@tauri-apps/cli": "^2.12.0",
    "@vue/test-utils": "^2.4.0",
    "cross-env": "^7.0.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.7.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.9.5",
    "sharp": "^0.35.3",
    "terser": "^5.49.0",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  }
}
